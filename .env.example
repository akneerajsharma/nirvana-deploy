# Copy to .env on the EC2 box and fill in. `chmod 600 .env` — it holds every
# production secret. Never commit the filled-in copy.

# --- The one value everything else derives from ------------------------
# Apex domain only, no scheme and no www. Nginx serves:
#   https://${DOMAIN}       and https://www.${DOMAIN}  -> web  (Next.js)
#   https://api.${DOMAIN}                              -> backend (NestJS)
#   https://app.${DOMAIN}                              -> app  (Flutter web)
DOMAIN=example.com

# --- Postgres ----------------------------------------------------------
POSTGRES_USER=nirvana
POSTGRES_DB=nirvana
# openssl rand -base64 32 | tr -d '/+=' 
POSTGRES_PASSWORD=

# --- JWT ---------------------------------------------------------------
# openssl rand -base64 48   (each must differ; min 16 chars)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# --- OTP ---------------------------------------------------------------
OTP_TTL_SECONDS=300
OTP_LENGTH=6

# --- Media storage -----------------------------------------------------
# local = written to the `uploads` docker volume and served from
#         https://api.${DOMAIN}/uploads. Fine to start with; it lives on this
#         one EBS volume, so back it up (scripts/30-backup.sh does).
# s3    = real S3; fill in the AWS_* and S3_MEDIA_BUCKET values below.
STORAGE_PROVIDER=local
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_MEDIA_BUCKET=nirvana-media-local
S3_ENDPOINT=

# --- Messaging vendors (still open decisions — docs/project-context.md §8) --
# `console` logs the OTP instead of sending it. Real logins will not work
# until a real SMS vendor is wired in.
SMS_PROVIDER=console
WHATSAPP_PROVIDER=console

# --- Payments ----------------------------------------------------------
PAYMENT_PROVIDER=razorpay
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=

# --- Mail --------------------------------------------------------------
MAIL_FROM_ADDRESS=no-reply@example.com

# Where Let's Encrypt sends expiry warnings. Use a mailbox someone reads —
# it is the only warning you get before a certificate lapses.
CERT_EMAIL=

# --- Deploy-script settings (not read by the app) ----------------------
# HTTPS works for public repos. For private ones, add a read-only deploy key
# to each repo on GitHub, put the private key on the box, and switch these to
# the SSH form: git@github.com:akneerajsharma/nirvana-backend.git
BACKEND_REPO=https://github.com/akneerajsharma/nirvana-backend.git
WEB_REPO=https://github.com/akneerajsharma/nirvana-frontend.git
GIT_BRANCH=main
